    ("JW87", 112.125, -99.375, 270, True, 106.25, -108.75, 118., -90., 0., 0.6),
    ("JW88", 98.5, -96.5, 0, True, 88.5, -100.75, 108.5, -92.25, 0., 0.6),
]
IDF_HEADER = ['.HEADER', 'BOARD_FILE 3.0 "FreeCAD" 2026/01/01.00:00:00 1', '"%s" MM' % NAME, '.END_HEADER', '.PLACEMENT']

def face(points):
    pts = [App.Vector(x, y, 0) for x, y in points]
    return Part.Face(Part.makePolygon(pts + pts[:1]))


def build():
    doc = App.newDocument(NAME)
    board = face(OUTLINE).extrude(App.Vector(0, 0, THICKNESS))
    for cut in CUTOUTS:
        board = board.cut(face(cut).extrude(App.Vector(0, 0, THICKNESS)))
    for x, y, d in HOLES:
        board = board.cut(Part.makeCylinder(d / 2, THICKNESS, App.Vector(x, y, 0)))
    doc.addObject("Part::Feature", "Board").Shape = board
    for ref, x, y, rot, bottom, x0, y0, x1, y1, z0, h in PARTS:
        part = doc.addObject("Part::Feature", "Part")
        part.Label = ref
        part.Shape = Part.makeBox(x1 - x0, y1 - y0, h, App.Vector(x0 - x, y0 - y, 0))
        part.Placement = App.Placement(App.Vector(x, y, -z0 - h if bottom else THICKNESS + z0), App.Rotation())
        part.addProperty("App::PropertyString", "SiedaRef", "SiEDA").SiedaRef = ref
        part.addProperty("App::PropertyFloat", "SiedaRotation", "SiEDA").SiedaRotation = rot
        part.addProperty("App::PropertyBool", "SiedaBottom", "SiEDA").SiedaBottom = bottom
    doc.recompute()


def send_back(doc):
    lines = list(IDF_HEADER)
    for part in doc.Objects:
        if hasattr(part, "SiedaRef"):
            p = part.Placement
            angle = (part.SiedaRotation + p.Rotation.toEuler()[0]) % 360
            lines.append('"PART" "PART" "%s"' % part.SiedaRef)
            lines.append("%.4f %.4f 0 %.2f %s PLACED" % (p.Base.x, p.Base.y, angle, "BOTTOM" if part.SiedaBottom else "TOP"))
    lines.append(".END_PLACEMENT")
    folder = os.path.dirname(doc.FileName) if doc.FileName else os.path.expanduser("~")
    path = os.path.join(folder, NAME + "-placement.emn")
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")
    App.Console.PrintMessage("SiEDA placement written to %s\n" % path)


doc = App.ActiveDocument
if doc is not None and any(hasattr(o, "SiedaRef") for o in doc.Objects):
    send_back(doc)
else:
    build()

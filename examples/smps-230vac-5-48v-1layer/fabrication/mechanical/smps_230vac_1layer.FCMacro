    ("JW73", 97.717635, -107.336515, 0, True, 93.93527, -113.423029, 101.5, -101.25, 0., 0.6),
    ("JW74", 73.375, -136.75, 0, True, 72.5, -141., 74.25, -132.5, 0., 0.6),
    ("JW75", 86.66786, -128.765596, 0, True, 75.83572, -131.281193, 97.5, -126.25, 0., 0.6),
    ("JW76", 86.625, -140.25, 0, True, 84.5, -143.25, 88.75, -137.25, 0., 0.6),
    ("JW77", 79.507943, -141.129437, 270, True, 75.5, -141.508874, 83.515885, -140.75, 0., 0.6),
    ("JW78", 106.125, -104., 0, True, 97.75, -119.75, 114.5, -88.25, 0., 0.6),
    ("JW79", 103.125, -82., 270, True, 98.5, -82.5, 107.75, -81.5, 0., 0.6),
    ("JW80", 104., -57.75, 270, True, 103.7, -73.25, 104.3, -42.25, 0., 0.6),
    ("JW81", 90.75, -104.875, 270, True, 90.45, -109., 91.05, -100.75, 0., 0.6),
    ("JW82", 99.115987, -100.453481, 270, True, 92.231974, -101.5, 106., -99.406961, 0., 0.6),
    ("JW83", 82.761139, -125.476411, 0, True, 73.25, -143.25, 92.272278, -107.702822, 0., 0.6),
    ("JW84", 82.375, -152.875, 270, True, 81.5, -163.25, 83.25, -142.5, 0., 0.6),
    ("JW85", 84.883222, -138.997029, 0, True, 79.516444, -142.244057, 90.25, -135.75, 0., 0.6),
